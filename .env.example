# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=deeprag
MYSQL_USER=deeprag
MYSQL_PASSWORD=changeme

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Qdrant
QDRANT_HOST=http://qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# 阿里云 OSS
OSS_ENDPOINT=
OSS_BUCKET=deeprag-dev
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# LLM(OpenAI兼容端点; 字段名历史沿用LITELLM_*, 实际经ModelGateway/langchain-openai调用)
LITELLM_MODEL=gpt-4o-mini
LITELLM_API_KEY=
LITELLM_BASE_URL=

# Embedding模型(SiliconFlow)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_DIMENSIONS=1024

# JWT(鉴权); 不设则用代码内开发默认值, 部署必须显式设置(评审20261126)
JWT_SECRET=

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false

# 查询缓存语义匹配(评审20261126默认关闭: 词袋重叠反义误命中; 向量相似度方案落地后再开)
CACHE_SEMANTIC_ENABLED=false

# 检索调优(kb模式)
# 首轮检索前query预改写(20261127: 口语问12/62召回不足被拒答阈值误降级; fast模型1次调用~1s)
RETRIEVAL_QUERY_REWRITE=true
# 拒答校准阈值(rerank top1低于此值直接降级; 标定见config.py)
RETRIEVAL_MIN_SCORE=0.30
# hybrid稀疏路权重(扫参定0.15≈纯dense最优, 详见config.py)
RETRIEVAL_SPARSE_WEIGHT=0.15

# 记忆系统(即插即用)
# 20261126封存决定: 长期记忆P1/P2/P3默认关断(未做质量A/B, 详见docs/P0_VERIFICATION.md);
# 短期记忆治理(MEMORY_ENABLED)保留默认开。
MEMORY_ENABLED=true
MEMORY_LONG_TERM_ENABLED=false
MEMORY_AUTO_WRITE=false

# Langfuse (可选, 三key齐全即启用LLM trace)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
